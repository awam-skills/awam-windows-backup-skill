# 复制为 config/repository.env 后按本机修改
# 命令: powershell -File scripts/init-config.ps1

# Kopia 可执行文件
KOPIA_EXE=I:\Software\kopia-0.23.1-windows-x64\kopia.exe

# 仓库物理路径（备份目标）
KOPIA_REPO_PATH=I:\Backup\KopiaRepo

# 仓库密码（create 与之后 backup/restore 必须一致）
KOPIA_PASSWORD=changeme

# 本机 Kopia 连接配置落点
KOPIA_CONFIG_PATH=C:\Users\Administrator\AppData\Local\kopia\repository.config

# 覆盖仓库内记录的用户名/主机名（可选；留空则用当前系统）
KOPIA_USERNAME=Administrator
KOPIA_HOSTNAME=DESKTOP-RPHK68H

# 系统配置导出暂存目录（export-system-config.ps1 写入 latest/）
SYSTEM_CONFIG_PATH=I:\Backup\SystemConfig

# 恢复默认落地目录
RESTORE_TEMP=I:\Backup\RestoreTemp
