# 复制为 config/repository.env 后按本机修改
# 命令: powershell -File scripts/init-config.ps1

# Kopia 可执行文件（从 github.com/kopia/kopia/releases 下载解压后的 kopia.exe 实际路径）
KOPIA_EXE=C:\Tools\kopia\kopia.exe

# 仓库物理路径（备份目标）
KOPIA_REPO_PATH=D:\Backup\KopiaRepo

# 仓库密码（create 与之后 backup/restore 必须一致）
KOPIA_PASSWORD=changeme

# 本机 Kopia 连接配置落点
KOPIA_CONFIG_PATH=C:\Users\<你的用户名>\AppData\Local\kopia\repository.config

# 覆盖仓库内记录的用户名/主机名（可选；留空则用当前系统）
KOPIA_USERNAME=
KOPIA_HOSTNAME=

# 系统配置导出暂存目录（export-system-config.ps1 写入 latest/；留空默认 <技能根>\_data\SystemConfig）
SYSTEM_CONFIG_PATH=D:\Backup\SystemConfig

# 恢复默认落地目录（留空默认 <技能根>\_data\RestoreTemp）
RESTORE_TEMP=D:\Backup\RestoreTemp

# 额外的 Program Files 根目录，分号分隔（可选）
# 应用配置探测默认只扫 C:/C:(x86)/D: 的 Program Files；
# 软件装在其他盘（如 S:\Program Files）时在此登记，用于 Easy Context Menu / PotPlayer / Total Commander 的 ini 探测
EXTRA_PROGRAM_DIRS=
